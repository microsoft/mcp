        },
        "MonitoringProperties": {
            "description": "The Monitoring properties.",
            "type": "object",
            "properties": {
                "dataCollectionState": {
                    "description": "The data collection state of the Monitoring item. This property is read-only and is transitioned only through the enable and disable data collection operations. Additional data collection states may be added over time.",
                    "type": "string",
                    "readOnly": true,
                    "enum": [
                        "Enabled",
                        "Disabled"
                    ],
                    "x-ms-enum": {
                        "name": "DataCollectionState",
                        "modelAsString": true,
                        "values": [
                            {
                                "value": "Enabled",
                                "description": "Data collection is active for the Monitoring item."
                            },
                            {
                                "value": "Disabled",
                                "description": "Data collection is not active for the Monitoring item."
                            }
                        ]
                    }
                }
            }
        },
        "MonitoringItems": {
            "description": "A list of Monitoring items.",
            "required": ["value"],
            "type": "object",
            "properties": {
                "value": {
                    "description": "A list of Monitoring items.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Monitoring"
                    },
                    "readOnly": true
                }
            },
            "allOf": [
                {
                    "$ref": "../common/definitions.json#/definitions/PaginatedResponse"
                }
            ]
        },
        "CreateMonitoringRequest": {
            "description": "The request payload for creating a Monitoring.",
            "required": ["displayName"],
            "properties": {
                "displayName": {
                    "description": "The Monitoring display name. Must contain 2 to 128 characters using only ASCII letters, digits, underscores (_), periods (.), and hyphens (-), with no spaces and no leading or trailing double underscore (__).",
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 128,
                    "pattern": "^(?!__)(?!.*__$)[0-9a-zA-Z_.-]+(?![\\s\\S])",
                    "readOnly": false
                },
                "description": {
                    "description": "The Monitoring description. Maximum length is 256 characters.",
                    "type": "string",
                    "maxLength": 256,
                    "readOnly": false
                },
                "folderId": {
                    "description": "The folder ID. If not specified or null, the Monitoring is created with the workspace as its folder.",
                    "type": "string",
                    "format": "uuid",
                    "readOnly": false
                },
                "definition": {
                    "description": "The Monitoring public definition.",
                    "$ref": "#/definitions/MonitoringPublicDefinition",
                    "readOnly": false
                },
                "sensitivityLabelSettings": {
                    "description": "The sensitivity label settings for the Monitoring.",
                    "$ref": "../common/definitions.json#/definitions/SensitivityLabelSettings",
                    "readOnly": false
                }
            }
        },
        "UpdateMonitoringDefinitionRequest": {
            "description": "The request payload for updating a Monitoring public definition.",
