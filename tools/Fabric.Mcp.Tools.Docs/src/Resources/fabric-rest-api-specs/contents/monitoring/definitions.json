            "description": "The Monitoring public definition object. Refer to this [article](/rest/api/fabric/articles/item-management/definitions/monitoring-definition) for more details on the structure of the Monitoring definition.",
            "type": "object",
            "required": ["parts"],
            "properties": {
                "format": {
                    "description": "The format of the Monitoring definition. Additional `format` types may be added over time.",
                    "type": "string",
                    "enum": [
                        "MonitoringV1"
                    ],
                    "x-ms-enum": {
                        "name": "MonitoringDefinitionFormat",
                        "modelAsString": true,
                        "values": [
                            {
                                "value": "MonitoringV1",
                                "description": "The format for Monitoring definitions, designed to support CI/CD scenarios in Fabric. See [Monitoring - MonitoringV1 specification](/rest/api/fabric/articles/item-management/definitions/monitoring-definition) for more details."
                            }
                        ]
                    },
                    "readOnly": false
