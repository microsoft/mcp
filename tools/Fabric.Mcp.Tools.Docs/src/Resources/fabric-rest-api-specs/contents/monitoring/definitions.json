                    },
                    "readOnly": false
                }
            }
        },
        "MonitoringPublicDefinitionPart": {
            "description": "The Monitoring definition part object.",
            "type": "object",
            "required": ["path", "payload", "payloadType"],
            "properties": {
                "path": {
                    "description": "The Monitoring public definition part path.",
                    "type": "string",
                    "readOnly": false
                },
                "payload": {
                    "description": "The Monitoring public definition part payload.",
                    "type": "string",
                    "readOnly": false
                },
                "payloadType":{
                    "description": "The payload type.",
                    "$ref": "../common/definitions.json#/definitions/PayloadType",
                    "readOnly": false
