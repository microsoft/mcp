                    "type": "string"
                },
                "customLivePoolLifespan": {
                    "description": "Maximum lifetime of a live pool activation, using the ISO 8601 duration format. The live pool job runs for this duration and then terminates. Minimum: PT30M. Maximum: PT24H.",
