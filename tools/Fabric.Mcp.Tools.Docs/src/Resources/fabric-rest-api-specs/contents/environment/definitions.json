                    "type": "integer",
                    "minimum": 1
                },
                "clusterIdleTimeout": {
                    "description": "Idle-time threshold after which a hydrated cluster is released, using the ISO 8601 duration format. Minimum: PT20M. Maximum: PT24H.",
