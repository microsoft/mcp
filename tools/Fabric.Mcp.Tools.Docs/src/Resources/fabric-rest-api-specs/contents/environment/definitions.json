        "CustomLivePoolSettings": {
            "description": "Live pool hydration settings on the environment's spark compute.",
            "type": "object",
            "properties": {
                "maxClustersToHydrate": {
                    "description": "Maximum number of clusters to pre-hydrate during each activation cycle. Minimum: 1. The maximum allowed value is determined by the capacity size and is exposed on the instance pool settings as `InstancePool.maxClustersToHydrateLimit`.",
