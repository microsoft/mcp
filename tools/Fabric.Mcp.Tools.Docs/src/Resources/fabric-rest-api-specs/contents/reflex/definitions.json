{
    "swagger": "2.0",
    "info": {
        "title": "Reflex data types",
        "version": "v1"
    },
    "paths": {},
    "definitions": {
        "Reflex": {
            "description": "A Reflex object.",
            "type": "object",
            "required": ["type"],
            "allOf": [
                {
                    "$ref": "../common/definitions.json#/definitions/Item"
                }
            ]
        },
        "Reflexes": {
            "description": "A list of Reflexes.",
            "required": ["value"],
            "type": "object",
            "properties": {
                "value": {
                    "description": "A list of Reflexes.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Reflex"
                    }
                }
            },
            "allOf": [
                {
                    "$ref": "../common/definitions.json#/definitions/PaginatedResponse"
                }
            ]
        },
        "CreateReflexRequest": {
            "description": "Create Reflex request payload.",
            "required": ["displayName"],
            "properties": {
                "displayName": {
                    "description": "The Reflex display name. The display name must follow naming rules according to item type.",
                    "type": "string",
                    "readOnly": false
                },
                "description": {
                    "description": "The Reflex description. Maximum length is 256 characters.",
                    "type": "string",
                    "readOnly": false
                },
                "folderId": {
                    "description": "The folder ID. If not specified or null, the Reflex is created with the workspace as its folder.",
                    "type": "string",
                    "format": "uuid",
                    "readOnly": false
                },
                "definition": {
                    "description": "The Reflex public definition.",
                    "$ref": "#/definitions/ReflexDefinition",
                    "readOnly": false
                },
                "sensitivityLabelSettings": {
                    "description": "The sensitivity label settings for the Reflex.",
                    "$ref": "../common/definitions.json#/definitions/SensitivityLabelSettings",
                    "readOnly": false
                }
            }
        },
        "UpdateReflexDefinitionRequest": {
            "description": "Update Reflex public definition request payload.",
            "required": ["definition"],
            "properties": {
                "definition": {
                    "$ref": "#/definitions/ReflexDefinition"
                }
            }
        },
        "ReflexDefinitionResponse": {
            "description": "Reflex public definition response.",
            "required": ["definition"],
            "properties": {
                "definition": {
                    "$ref": "#/definitions/ReflexDefinition",
                    "readOnly": true
                }
            }
        },
        "ReflexDefinition" : {
            "description": "Reflex public definition object. Refer to this [article](/rest/api/fabric/articles/item-management/definitions/reflex-definition) for more details on the structure of the Reflex definition.",
            "type": "object",
            "required": ["parts"],
            "properties": {
                "format": {
                    "description": "The format of the reflex definition. Supported format: `json`.",
                    "type": "string",
                    "readOnly": false
                },
                "parts": {
                    "description": "A list of definition parts.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ReflexDefinitionPart"
                    },
                    "readOnly": false
                }
            }
        },
        "ReflexDefinitionPart": {
            "description": "Reflex definition part object.",
            "type": "object",
            "properties": {
                "path": {
                    "description": "The Reflex public definition part path.",
                    "type": "string",
                    "readOnly": false
                },
                "payload": {
                    "description": "The Reflex public definition part payload.",
                    "type": "string",
                    "readOnly": false
                },
                "payloadType":{
                    "description": "The payload type.",
                    "$ref": "../common/definitions.json#/definitions/PayloadType",
                    "readOnly": false
                }
            }
        },
        "UpdateReflexRequest": {
            "description": "Update Reflex request.",
            "properties": {
                "displayName": {
                    "description": "The Reflex display name. The display name must follow naming rules according to item type.",
                    "type": "string",
                    "readOnly": false
                },
                "description": {
                    "description": "The Reflex description. Maximum length is 256 characters.",
                    "type": "string",
                    "readOnly": false
                }
            }
        },
        "QueryActivationsRequest": {
            "description": "Query activations request payload.",
            "type": "object",
            "required": ["query"],
            "properties": {
                "query": {
                    "description": "The KQL query string to execute against the activation records. Supports standard KQL data queries (e.g., table queries, `union`, filtering, aggregation) and limited management commands (`.show tables`, `.show table {tableName} cslschema`). Wildcard `union` (e.g. `union *`) is not supported.",
                    "type": "string",
                    "maxLength": 1048576,
                    "readOnly": false
                }
            }
        },
        "QueryActivationsResponse": {
            "description": "Query activations response. Contains one result table per statement in the query, in source-text order.",
            "type": "object",
            "required": ["tables"],
            "properties": {
                "tables": {
                    "description": "An array of result tables. A single-statement query returns one table; a multi-statement query (for example a `.show table {tableName} cslschema` command chained with a data query) returns one table per statement, in source-text order.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ActivationsTable"
                    },
                    "readOnly": true
                }
            }
        },
        "ActivationsTable": {
            "description": "A single result table returned by an activations query.",
            "type": "object",
            "required": ["tableName", "columns", "rows"],
            "properties": {
                "tableName": {
                    "description": "The name of the result table. For a standard query, the primary result table is named `PrimaryResult`.",
                    "type": "string",
                    "readOnly": true
                },
                "columns": {
                    "description": "An array describing the columns of the result table.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ActivationsColumn"
                    },
                    "readOnly": true
                },
                "rows": {
                    "description": "An array of row arrays. Each inner array contains values positionally aligned with the columns array.",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "description": "A single cell value, positionally aligned with the corresponding column. The JSON type of the value reflects the column's KustoScalarDataType (for example string, number, boolean, or null)."
                        }
                    },
                    "readOnly": true
                }
            }
        },
        "ActivationsColumn": {
            "description": "Describes a column in the activations query result table.",
            "type": "object",
            "required": ["columnName", "columnType"],
            "properties": {
                "columnName": {
                    "description": "The name of the column.",
                    "type": "string",
                    "readOnly": true
                },
                "columnType": {
                    "description": "The KQL scalar data type of the column.",
                    "$ref": "#/definitions/KustoScalarDataType",
                    "readOnly": true
                }
            }
        },
        "KustoScalarDataType": {
            "description": "The KQL scalar data type of a column in the activations query result table. Additional KustoScalarDataType values may be added over time.",
            "type": "string",
            "enum": [
                "Bool",
                "DateTime",
                "Decimal",
                "Dynamic",
                "Guid",
                "Int",
                "Long",
                "Real",
                "String",
                "TimeSpan"
            ],
            "x-ms-enum": {
                "name": "KustoScalarDataType",
                "modelAsString": true,
                "values": [
                    {
                        "value": "Bool",
                        "description": "A boolean value (true or false)."
                    },
                    {
                        "value": "DateTime",
                        "description": "A date and time value."
                    },
                    {
                        "value": "Decimal",
                        "description": "A 128-bit decimal number."
                    },
                    {
                        "value": "Dynamic",
                        "description": "A dynamic value (JSON-like structure)."
                    },
                    {
                        "value": "Guid",
                        "description": "A globally unique identifier."
                    },
                    {
                        "value": "Int",
                        "description": "A 32-bit signed integer."
                    },
                    {
                        "value": "Long",
                        "description": "A 64-bit signed integer."
                    },
                    {
                        "value": "Real",
                        "description": "A 64-bit floating point number."
                    },
                    {
                        "value": "String",
                        "description": "A UTF-8 string value."
                    },
                    {
                        "value": "TimeSpan",
                        "description": "A time interval value."
                    }
                ]
            }
        }
    }
}
