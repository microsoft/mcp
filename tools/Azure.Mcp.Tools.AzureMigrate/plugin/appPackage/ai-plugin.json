{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
  "schema_version": "v2.4",
  "name_for_human": "__APP_NAME__",
  "namespace": "AzureMigrate",
  "description_for_human": "Create, check and export Azure Migrate server inventories, and create assessments and HA assessments.",
  "description_for_model": "Creates or updates an Azure Migrate inventory for the signed-in user (returning an azcopy command the user runs to upload their file), gets the status of an inventory operation, exports the refined inventory or offline zip, creates an assessment followed by an HA assessment, and gets assessment and HA status.",
  "functions": [
    {
      "name": "azure_catalyst_inventory_createorupdate",
      "description": "Create or Update Azure Catalyst Inventory.",
      "capabilities": {
        "security_info": {
          "data_handling": [
            "DataTransform"
          ]
        }
      }
    },
    {
      "name": "azure_catalyst_inventory_status",
      "description": "Get Azure Catalyst Inventory Status.",
      "capabilities": {
        "security_info": {
          "data_handling": [
            "DataTransform"
          ]
        }
      }
    },
    {
      "name": "azure_catalyst_inventory_export",
      "description": "Export Azure Catalyst Inventory.",
      "capabilities": {
        "security_info": {
          "data_handling": [
            "DataTransform"
          ]
        }
      }
    },
    {
      "name": "azure_catalyst_businesscase_create",
      "description": "Create Azure Catalyst Business Case.",
      "capabilities": {
        "security_info": {
          "data_handling": [
            "DataTransform"
          ]
        }
      }
    },
    {
      "name": "azure_catalyst_businesscase_status",
      "description": "Get Azure Catalyst Business Case Status.",
      "capabilities": {
        "security_info": {
          "data_handling": [
            "DataTransform"
          ]
        }
      }
    },
    {
      "name": "azure_catalyst_businesscase_wait",
      "description": "Wait For Azure Catalyst Business Case.",
      "capabilities": {
        "security_info": {
          "data_handling": [
            "DataTransform"
          ]
        }
      }
    },
    {
      "name": "azure_catalyst_inventory_wait",
      "description": "Wait For Azure Catalyst Inventory.",
      "capabilities": {
        "security_info": {
          "data_handling": [
            "DataTransform"
          ]
        }
      }
    },
    {
      "name": "azure_catalyst_session_archive",
      "description": "Start a New Azure Catalyst Session.",
      "capabilities": {
        "security_info": {
          "data_handling": [
            "DataTransform"
          ]
        }
      }
    }
  ],
  "runtimes": [
    {
      "type": "RemoteMCPServer",
      "auth": {
        "type": "None"
      },
      "spec": {
        "url": "__MCP_URL__",
        "mcp_tool_description": {
          "file": "mcp-tools.json"
        }
      },
      "run_for_functions": [
        "azure_catalyst_inventory_createorupdate",
        "azure_catalyst_inventory_status",
        "azure_catalyst_inventory_export",
        "azure_catalyst_businesscase_create",
        "azure_catalyst_businesscase_status",
        "azure_catalyst_businesscase_wait",
        "azure_catalyst_inventory_wait",
        "azure_catalyst_session_archive"
      ]
    }
  ]
}
